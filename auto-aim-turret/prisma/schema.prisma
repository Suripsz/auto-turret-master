// Prisma schema for auto-aim-turret
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model FireEvent {
  id          String   @id @default(uuid())
  target      String
  distance_cm Float
  timestamp   DateTime @default(now())

  @@map("fire_events")
}
